<Window x:Class="VRCDeskDive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VRCDeskDive"
        Title="VRCDeskDive" Width="880" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- 角丸の枠。背景は半透明のグラデーションで、後ろに Windows の背景ぼかしがかかる -->
    <Border x:Name="WindowFrame" CornerRadius="16" Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource WindowBorder}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="FrameShift"/>
        </Border.RenderTransform>
        <!-- 中身を角丸で切り抜く（Clip はコードでサイズに合わせる） -->
        <Grid x:Name="ClipHost">
            <!-- 背景の光 -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="620" Height="620" Canvas.Left="420" Canvas.Top="-330" Fill="{StaticResource GlowBlue}"/>
                <Ellipse Width="520" Height="520" Canvas.Left="-260" Canvas.Top="260" Fill="{StaticResource GlowCyan}"/>
            </Canvas>

            <DockPanel>
                <!-- ===== タイトルバー（ドラッグで移動） ===== -->
                <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="50" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <!-- ロゴ -->
                        <Grid Width="26" Height="26" Margin="0,0,11,0">
                            <Border CornerRadius="8" BorderBrush="#5593C5FD" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#05080F" Offset="0"/>
                                        <GradientStop Color="#0E2656" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Path Data="M 7.5,8.5 L 13,18 L 18.5,8.5" Stroke="{StaticResource VrGradient}" StrokeThickness="2.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Path.Effect>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="TitleText" Text="VRCDeskDive" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="21" Foreground="{StaticResource TitleGradient}" VerticalAlignment="Center"/>
                        <Border x:Name="VersionBadge" CornerRadius="6" Padding="7,1" Margin="10,2,0,0" VerticalAlignment="Center"
                                Background="#1A60A5FA" BorderBrush="#3360A5FA" BorderThickness="1">
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                       FontSize="12" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ToggleButton x:Name="TopmostButton" Style="{StaticResource TitleBarToggle}" Content="&#xE718;"
                                      ToolTip="最前面に固定" Click="TopmostButton_Click"/>
                        <ToggleButton x:Name="CompactButton" Style="{StaticResource TitleBarToggle}" Content="&#xE73F;"
                                      ToolTip="縮小表示" Margin="2,0,0,0" Click="CompactButton_Click"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="最小化"
                                Margin="2,0,0,0" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="終了"
                                Margin="2,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 画面が小さいときはスクロールできるようにする（MaxHeight はコードで作業領域に合わせる） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="RootGrid" Margin="22,0,22,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftColumn" Width="400"/>
                            <ColumnDefinition x:Name="SpacerColumn" Width="20"/>
                            <ColumnDefinition x:Name="RightColumn" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== 左: 切り替えと視点操作（縮小表示ではここだけ） ===== -->
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="Subtitle" Text="VRChatを落とさずに、VR操作とデスクトップ操作を切り替え"
                                       Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,14"/>

                            <!-- モード -->
                            <Border x:Name="ModeCard" CornerRadius="16" Padding="20,16" BorderThickness="1.5"
                                    Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ModeGlow" BlurRadius="34" ShadowDepth="0" Opacity="0.35" Color="#3B82F6"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="ModeLabel" Style="{StaticResource Caption}" Margin="0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="ModeText" FontSize="30" FontWeight="Bold" Margin="0,0,0,2"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="ModeHint" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Click="ToggleButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 視点パッド -->
                            <local:LookPad x:Name="LookPad" Margin="0,14,0,0"/>

                            <!-- 縮小表示用の簡易状態 -->
                            <Border x:Name="CompactStatus" Style="{StaticResource GlassCard}" Padding="14,8" Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CompactVrcDot" Width="8" Height="8" Margin="0,0,7,0"/>
                                    <TextBlock Text="VRChat" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,18,0"/>
                                    <Ellipse x:Name="CompactDriverDot" Width="8" Height="8" Margin="0,0,7,0"/>
                                    <TextBlock Text="DRIVER" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 接続状態 -->
                            <Border x:Name="StatusGrid" Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="STATUS"/><Run Text="  接続状態" FontFamily="{StaticResource UiFont}" FontWeight="Normal"
                                                                 FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </Grid.Resources>

                                        <TextBlock Text="VRChat"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="VrcDot" Width="9" Height="9" Margin="0,0,9,0"/>
                                            <TextBlock x:Name="VrcText" Text="未検出" Style="{x:Null}" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="SteamVR"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="SteamVrDot" Width="9" Height="9" Margin="0,0,9,0"/>
                                            <TextBlock x:Name="SteamVrText" Text="未起動" Style="{x:Null}" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="Driver"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DriverDot" Width="9" Height="9" Margin="0,0,9,0"/>
                                            <TextBlock x:Name="DriverText" Text="未接続" Style="{x:Null}" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="RegisterButton" Content="SteamVRに登録" Style="{StaticResource GhostButton}"
                                                    Margin="12,0,0,0" Visibility="Collapsed" Click="RegisterButton_Click"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Text="OSC"/>
                                        <TextBlock x:Name="OscText" Grid.Row="3" Grid.Column="1" Style="{x:Null}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource SubTextBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="DriverHint" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                               Visibility="Collapsed" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 右: 設定と操作方法 ===== -->
                        <StackPanel x:Name="RightPanel" Grid.Column="2">
                            <!-- 設定 -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="SETTINGS"/><Run Text="  設定" FontFamily="{StaticResource UiFont}" FontWeight="Normal"
                                                                   FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="マウス感度" Style="{StaticResource Label}"/>
                                        <Slider x:Name="SensitivitySlider" Grid.Column="1" Style="{StaticResource ModernSlider}"
                                                Minimum="0.2" Maximum="3" VerticalAlignment="Center"
                                                ValueChanged="SensitivitySlider_ValueChanged"/>
                                        <TextBlock x:Name="SensitivityText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17" Foreground="#93C5FD"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,10,0,8"/>
                                    <DockPanel>
                                        <ComboBox x:Name="ReleaseKeyCombo" DockPanel.Dock="Right" Width="78" Style="{StaticResource ModernComboBox}"
                                                  ToolTip="マウスルックを解除するキー（解除したあとも、そのキーはVRChatにそのまま届きます）"
                                                  SelectionChanged="ReleaseKeyCombo_SelectionChanged"/>
                                        <TextBlock DockPanel.Dock="Right" Text="解除キー" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="ClickLookCheck" Style="{StaticResource ToggleSwitch}"
                                                  Content="VRChatを左クリックでマウスルック"
                                                  Checked="ClickLookCheck_Changed" Unchecked="ClickLookCheck_Changed"/>
                                    </DockPanel>
                                    <CheckBox x:Name="SoundCheck" Style="{StaticResource ToggleSwitch}" Content="切り替え時に音を鳴らす"
                                              Checked="SoundCheck_Changed" Unchecked="SoundCheck_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- キー操作 -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="CONTROLS"/><Run Text="  デスクトップ操作中のキー" FontFamily="{StaticResource UiFont}"
                                                                   FontWeight="Normal" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Border Grid.Row="0" Style="{StaticResource KeyCap}"><TextBlock Text="W A S D" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="移動"/>
                                        <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="左クリック" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="マウスルック"/>
                                        <Border Grid.Row="2" Style="{StaticResource KeyCap}"><TextBlock x:Name="ReleaseKeyCap" Text="Alt" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="マウスルック解除"/>
                                        <Border Grid.Row="3" Style="{StaticResource KeyCap}"><TextBlock Text="ホイール押し" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="水平に戻す"/>

                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Shift" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="走る"/>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Space" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="ジャンプ"/>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="V" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="マイク"/>
                                        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Foreground="{StaticResource TextBrush}"/></Border>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="チャット入力"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 使う前に -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="SETUP"/><Run Text="  使う前に" FontFamily="{StaticResource UiFont}" FontWeight="Normal"
                                                                FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" LineHeight="21">
                                        <Run Text="›" Foreground="#60A5FA" FontWeight="Bold"/>
                                        <Run Text="VRChatのアクションメニュー → オプション → OSC を有効にする"/>
                                        <LineBreak/>
                                        <Run Text="›" Foreground="#60A5FA" FontWeight="Bold"/>
                                        <Run Text="視点の操作と水平の固定には、ドライバーをSteamVRに登録してSteamVRを再起動する"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>

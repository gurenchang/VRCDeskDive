<Window x:Class="VRCDeskDive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VRCDeskDive"
        Title="VRCDeskDive" Width="860" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
    <!-- 画面が小さいときはスクロールできるようにする（MaxHeight はコードで作業領域に合わせる） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22,18,22,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左: 切り替えと視点操作 ===== -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="VRCDeskDive" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="VRChatを落とさずに、VR操作とデスクトップ操作を切り替え"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,14"/>

                <Border x:Name="ModeCard" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18,14"
                        BorderThickness="2" BorderBrush="{StaticResource VrBrush}">
                    <StackPanel>
                        <TextBlock Text="現在のモード" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="ModeText" Text="VR操作" FontSize="26" FontWeight="Bold" Margin="0,2,0,2"/>
                        <TextBlock x:Name="ModeHint" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,12"/>
                        <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Click="ToggleButton_Click"/>
                    </StackPanel>
                </Border>

                <local:LookPad x:Name="LookPad" Margin="0,12,0,0"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="切り替えキー" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" Cursor="Hand" Width="180"
                             HorizontalAlignment="Left" Padding="8,4" Margin="0,3"
                             Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="Transparent"
                             ToolTip="クリックしてから新しいキーの組み合わせを押してください"
                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                    <TextBlock Grid.Row="1" Text="VRChat" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="VrcDot" Width="9" Height="9" Fill="Gray" Margin="0,0,7,0"/>
                        <TextBlock x:Name="VrcText" Text="未検出"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="上下視点" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="TiltDot" Width="9" Height="9" Fill="Gray" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TiltText"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="OSC送信先" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="OscText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="HotkeyError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== 右: 設定と操作方法 ===== -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="設定" Style="{StaticResource SectionHeader}" Margin="0,4,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="左右の感度" Style="{StaticResource Label}"/>
                    <Slider x:Name="SensitivitySlider" Grid.Column="1" Minimum="0.2" Maximum="3" VerticalAlignment="Center"
                            ValueChanged="SensitivitySlider_ValueChanged"/>
                    <TextBlock x:Name="SensitivityText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1" Text="上下の感度" Style="{StaticResource Label}"/>
                    <Slider x:Name="PitchSlider" Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="3" VerticalAlignment="Center"
                            ValueChanged="PitchSlider_ValueChanged"/>
                    <TextBlock x:Name="PitchText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Text="Q/E 旋回速度" Style="{StaticResource Label}"/>
                    <Slider x:Name="TurnSlider" Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="1" VerticalAlignment="Center"
                            ValueChanged="TurnSlider_ValueChanged"/>
                    <TextBlock x:Name="TurnText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <CheckBox x:Name="InvertPitchCheck" Content="上下の視点を反転する" Margin="0,8,0,4"
                          Checked="InvertPitchCheck_Changed" Unchecked="InvertPitchCheck_Changed"/>
                <CheckBox x:Name="FocusOnlyCheck" Content="VRChatが前面にあるときだけ操作する（推奨）"
                          Checked="FocusOnlyCheck_Changed" Unchecked="FocusOnlyCheck_Changed"/>
                <CheckBox x:Name="SoundCheck" Content="切り替え時に音を鳴らす"
                          Checked="SoundCheck_Changed" Unchecked="SoundCheck_Changed"/>

                <TextBlock Text="デスクトップ操作中のキー" Style="{StaticResource SectionHeader}"/>
                <!-- 2列に並べて縦の長さを抑える -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KeyCap}"><TextBlock Text="W A S D"/></Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="移動" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="右ドラッグ"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="視点を動かす" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Style="{StaticResource KeyCap}"><TextBlock Text="ホイール押し"/></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="上下を正面に" VerticalAlignment="Center"/>
                    <Border Grid.Row="3" Style="{StaticResource KeyCap}"><TextBlock Text="Q / E"/></Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="左右に旋回" VerticalAlignment="Center"/>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Shift"/></Border>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="走る" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Space"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="ジャンプ" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="V"/></Border>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="マイク" VerticalAlignment="Center"/>
                    <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyCap}"><TextBlock Text="Enter"/></Border>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="チャット入力" VerticalAlignment="Center"/>
                </Grid>

                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" LineHeight="20">
                        <Run Text="使う前に:"/>
                        <LineBreak/>
                        <Run Text="・VRChatのアクションメニュー → オプション → OSC を有効にする"/>
                        <LineBreak/>
                        <Run Text="・スムーズに回すなら、VRChatの快適ターンをオフにする"/>
                        <LineBreak/>
                        <Run Text="・上下の視点はSteamVRのプレイスペースを傾けて動かします（VR操作に戻すと元どおり）"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

<UserControl x:Class="VRCDeskDive.LookPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="170" Cursor="SizeAll">
    <Border x:Name="Frame" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}">
        <!-- 中心がほんのり光るレーダー風の面 -->
        <Border.Background>
            <RadialGradientBrush RadiusX="0.65" RadiusY="0.9">
                <GradientStop Color="#223B82F6" Offset="0"/>
                <GradientStop Color="#0AFFFFFF" Offset="0.55"/>
                <GradientStop Color="#05FFFFFF" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Grid ClipToBounds="True">
            <!-- 十字線と同心円 -->
            <Grid IsHitTestVisible="False">
                <Rectangle Height="1" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="1" HorizontalAlignment="Center">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="128" Height="128" Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Ellipse Width="64" Height="64" Stroke="#1CFFFFFF" StrokeThickness="1"/>
            </Grid>

            <!-- マウスのアイコン（右上） -->
            <Canvas Width="16" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
                    IsHitTestVisible="False" Opacity="0.6">
                <Rectangle Width="16" Height="24" RadiusX="8" RadiusY="8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"/>
                <Line X1="8" Y1="4" X2="8" Y2="9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"/>
                <Path Data="M 8,0 A 8,8 0 0 1 16,8 L 16,10 L 8,10 Z" Fill="{DynamicResource AccentBrush}"/>
            </Canvas>

            <StackPanel x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="DRAG TO LOOK" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="HintTitle" Text="ここで右クリック＋ドラッグ" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="HintSub" Text="右クリック＋ドラッグでHMD視点を回転 / ホイール押しで水平に戻す" Margin="16,4,16,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>

            <!-- ドラッグ中のスティック表示 -->
            <Canvas x:Name="StickLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="3 3" Opacity="0.7"/>
                <Line x:Name="Arm" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" Opacity="0.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="Knob" Width="28" Height="28" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#818CF8" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="VRCDeskDive.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCDeskDive チャット" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Frame" CornerRadius="16" Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource DesktopGradient}" BorderThickness="1.5" Padding="20,14,20,16">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0/144" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0" Foreground="#C084FC">
                    <Run Text="CHATBOX"/><Run Text="  チャットボックスに送信" FontFamily="{StaticResource UiFont}" FontWeight="Normal"
                                              FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </TextBlock>
            </DockPanel>
            <TextBox x:Name="Input" Style="{StaticResource ModernTextBox}" MaxLength="144" FontSize="17"
                     KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource KeyCap}" Margin="0,0,6,0"><TextBlock Text="Enter"/></Border>
                <TextBlock Text="送信" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Style="{StaticResource KeyCap}" Margin="0,0,6,0"><TextBlock Text="Esc"/></Border>
                <TextBlock Text="キャンセル" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
